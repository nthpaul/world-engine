{"tasks":[{"id":"gitlab-issue-close","version":"1.0.1","name":"GitLab release issue closure","instruction":"In Release Operations, find the open issue whose description says Deployment reference: REL-2026-1042. Add exactly this comment: Release checklist verified; ready for closure. Then close that issue. Use an ordinary comment, not an internal note. Leave other issues, existing comments and project access unchanged.","application":"GitLab CE","application_version":"19.4.1","image_digest":"sha256:7fff8748a25202c1d38885797510afe055f555856f3f50c2b17466a853be5d24","fixture_hash":"261a0941f8a69efeac5632d9a81ffcbce27c8bbd1f7726aac6b438db3f17c956","grader_version":"gitlab-state-v2","seed":42,"observation_mode":"AX","evaluation_only":true}]}